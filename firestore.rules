rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 선생님(김정이) 개인 전용 도구 — dashboardData, calendarData, seatingData
    // 컬렉션 모두 본인 구글 계정으로 로그인해야만 읽고 쓸 수 있습니다.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'dlrka0131@gmail.com';
    }
  }
}
